// Cloudflare Workers 배포 설정
// - 사이트 파일(HTML·CSS·JS·이미지)은 정적 파일로 그대로 배포합니다.
// - /api/ 로 시작하는 주소만 worker/index.js 가 처리합니다(Q&A 재배상담).
// - DB(D1) "hanil-qna"는 처음 배포할 때 Cloudflare가 자동으로 만듭니다.
// - 담당자 비밀번호는 이 파일에 넣지 않습니다. Cloudflare 화면의
//   Workers → hanil-catalog → Settings → Variables and Secrets 에서
//   Secret 이름 ADMIN_PASSWORD 로 직접 등록합니다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanil-catalog",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hanil-qna" }
  ],
  "observability": { "enabled": true }
}
